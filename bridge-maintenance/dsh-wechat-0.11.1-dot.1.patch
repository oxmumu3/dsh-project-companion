+/** A connection could not be established, so no message request was written.
+ * Socket resets and generic timeouts deliberately do not qualify: the gateway
+ * may already have accepted a message before the response was lost.
+ */
+export function isDefinitelyUnsentNetworkError(err: unknown): boolean {
+  const safe = new Set(["UND_ERR_CONNECT_TIMEOUT", "ECONNREFUSED", "EAI_AGAIN", "ENOTFOUND"]);
+  let current: unknown = err;
+  let found = false;
+  const seen = new Set<unknown>();
+  while (current && typeof current === "object" && !seen.has(current)) {
+    seen.add(current);
+    const item = current as { name?: unknown; code?: unknown; cause?: unknown; sendOutcome?: unknown };
+    if (item.sendOutcome === "uncertain") return false;
+    if (item.name === "AbortError" || ["ECONNRESET", "ETIMEDOUT", "UND_ERR_SOCKET", "UND_ERR_HEADERS_TIMEOUT", "UND_ERR_BODY_TIMEOUT"].includes(String(item.code))) return false;
+    if (typeof item.code === "string" && safe.has(item.code)) found = true;
+    current = item.cause;
+  }
+  return found;
+}
