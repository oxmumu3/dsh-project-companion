+++ b/tests/dot-delivery.test.ts
@@ -0,0 +1,130 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const sendText = vi.fn();
+vi.mock("../src/weixin/send.js", async original => ({
+  ...await original<typeof import("../src/weixin/send.js")>(),
+  sendTextMessage: (...args: unknown[]) => sendText(...args),
+}));
+import { WeChatDSHBridge } from "../src/bridge/bridge.js";
+import { defaultConfig } from "../src/config.js";
+
+const connectionError = () => Object.assign(new Error("PRIVATE_NETWORK_ENDPOINT"), { cause: Object.assign(new Error("PRIVATE_ADDRESS"), { code: "ECONNREFUSED" }) });
+type Internal = {
+  token: unknown; wechatMsgCount: number; outboundSerial: Promise<void>;
+  state: { ensureUser(user: string, cwd: string): void; update(user: string, patch: unknown): void };
+  outboundCache: Array<{ kind: string; text: string }>;
+  deliverOutbound(user: string, item: unknown): Promise<string>;
+  handleMessage(message: unknown): Promise<void>;
+};
+let dir: string, bridge: WeChatDSHBridge, b: Internal;
+let events: Array<{ name: string; payload: any }>;
+let received: any[];
+beforeEach(() => {
+  vi.useFakeTimers(); sendText.mockReset().mockResolvedValue(undefined);
+  events = []; received = [];
+  const agent = { id: "s1", status: "idle", options: {}, followup: (message: any) => {
+    expect(events.some(event => event.payload.messageId === message.id)).toBe(true);
+    received.push(message);
+  }};
+  const agents = { get: () => agent, list: () => [agent], create: async () => ({ agent }), resume: async () => ({ agent }) };
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), "dot-wx-delivery-"));
+  bridge = new WeChatDSHBridge({ get: (name: string) => name === "agents" ? agents : undefined,
+    on: () => () => {}, emit: (name: string, payload: any) => { events.push({ name, payload }); } } as any,
+  { ...defaultConfig(), storageDir: dir });
+  b = bridge as unknown as Internal;
+  b.token = { baseUrl: "https://invalid.test", token: "PRIVATE_TOKEN" };
+  b.state.ensureUser("PRIVATE_PEER", "/synthetic"); b.state.update("PRIVATE_PEER", { sessionId: "s1" });
+});
+afterEach(async () => { await bridge.stop(); vi.useRealTimers(); fs.rmSync(dir, { recursive: true, force: true }); });
+
+describe("Dot definite-unsent recovery", () => {
+  it("retries a definite connection failure without a user message and drains FIFO once", async () => {
+    sendText.mockRejectedValueOnce(connectionError());
+    expect(await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "PRIVATE_REMINDER" })).toBe("cached");
+    expect(await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "PRIVATE_RESULT" })).toBe("cached");
+    expect(sendText).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1000); await b.outboundSerial;
+    expect(sendText.mock.calls.map(call => call[1])).toEqual(["PRIVATE_REMINDER", "PRIVATE_REMINDER", "PRIVATE_RESULT"]);
+    expect(b.outboundCache).toHaveLength(0);
+    await vi.advanceTimersByTimeAsync(60000); expect(sendText).toHaveBeenCalledTimes(3);
+  });
+
+  it("bounds retries and exposes only safe diagnostics without resetting the ten-message budget", async () => {
+    sendText.mockRejectedValue(connectionError());
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "PRIVATE_BODY" });
+    await vi.advanceTimersByTimeAsync(60000); await b.outboundSerial;
+    expect(sendText).toHaveBeenCalledTimes(4); // original + three bounded retries
+    const status = bridge.getStatus().outbound as any;
+    expect(status.queueCount).toBe(1); expect(status.messageCount).toBe(4);
+    expect(status.retry.scheduled).toBe(false); expect(status.retry.attempt).toBe(3);
+    expect(status.lastError.kind).toBe("definite_unsent");
+    expect(JSON.stringify(status)).not.toMatch(/PRIVATE|https:|token|peer|body/i);
+  });
+
+  it("does not retry a socket reset with an ambiguous outcome", async () => {
+    sendText.mockRejectedValueOnce(Object.assign(new Error("PRIVATE_BODY"), { code: "ECONNRESET" }));
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "PRIVATE_BODY" });
+    const attempted = sendText.mock.calls.length;
+    await vi.advanceTimersByTimeAsync(60000); await b.outboundSerial;
+    expect(sendText).toHaveBeenCalledTimes(attempted); expect(b.outboundCache).toHaveLength(1);
+    expect((bridge.getStatus().outbound as any).lastError.kind).toBe("uncertain");
+  });
+
+  it("an unknown queued failure is not mislabeled as a proven rate limit", async () => {
+    sendText.mockRejectedValueOnce(new Error("unclassified send failure"));
+    const result = await bridge.handleSendWeChat("s1", { text: "synthetic" });
+    expect(result.ok).toBe(true); expect(result.message).toMatch(/queued/);
+    expect(result.message).not.toMatch(/rate limit/i);
+  });
+
+  it("never lets a scheduled retry bypass a closed message window", async () => {
+    sendText.mockRejectedValueOnce(connectionError());
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "PRIVATE_BODY" });
+    b.wechatMsgCount = 10;
+    await vi.advanceTimersByTimeAsync(60000); await b.outboundSerial;
+    expect(sendText).toHaveBeenCalledTimes(1); expect(b.wechatMsgCount).toBe(10);
+    expect(b.outboundCache).toHaveLength(1);
+  });
+
+  it("cancels retry on unload while preserving the durable queue", async () => {
+    sendText.mockRejectedValueOnce(connectionError());
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "PRIVATE_BODY" });
+    await bridge.stop(); await vi.advanceTimersByTimeAsync(60000);
+    expect(sendText).toHaveBeenCalledTimes(1);
+    const stored = JSON.parse(fs.readFileSync(path.join(dir, "state.json"), "utf8"));
+    expect(stored.outbound.queue).toEqual([{ kind: "text", text: "PRIVATE_BODY" }]);
+  });
+
+  it("queue pressure cannot retry a head whose previous delivery is ambiguous", async () => {
+    b.outboundCache = Array.from({ length: 100 }, (_, i) => ({ kind: "text", text: `uncertain-${i}` }));
+    b.wechatMsgCount = 2;
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "new-tail" });
+    expect(sendText).not.toHaveBeenCalled(); expect(b.outboundCache).toHaveLength(101);
+    expect(b.outboundCache[0]?.text).toBe("uncertain-0");
+  });
+
+  it("unload during a pending retry does not send the next cached item", async () => {
+    let release!: () => void;
+    sendText.mockRejectedValueOnce(connectionError()).mockImplementationOnce(() => new Promise<void>(resolve => { release = resolve; }));
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "first" });
+    await b.deliverOutbound("PRIVATE_PEER", { kind: "text", text: "second" });
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(sendText).toHaveBeenCalledTimes(2); expect(typeof release).toBe("function");
+    await bridge.stop(); release(); await b.outboundSerial;
+    expect(sendText).toHaveBeenCalledTimes(2);
+    expect(b.outboundCache).toEqual([{ kind: "text", text: "second" }]);
+  });
+
+  it("emits a body-free exact-message receipt before forwarding the recovery input", async () => {
+    b.outboundCache = [{ kind: "text", text: "PRIVATE_REMINDER" }, { kind: "text", text: "PRIVATE_RESULT" }];
+    await b.handleMessage({ message_type: 1, from_user_id: "PRIVATE_PEER", item_list: [{ type: 1, text_item: { text: "只收取缓存" } }] });
+    expect(received).toHaveLength(1);
+    const event = events.find(event => event.name === "wechat/inbound-forwarded")!;
+    expect(event.payload.agent.id).toBe("s1"); expect(event.payload.messageId).toBe(received[0].id);
+    expect(event.payload.receipt).toEqual({ attempted: true, sent: 2, remaining: 0, dropped: 0 });
+    expect(JSON.stringify(event.payload.receipt)).not.toMatch(/PRIVATE|token|peer|body/i);
+  });
+});
