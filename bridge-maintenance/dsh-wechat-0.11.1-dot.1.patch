+import { afterEach, expect, it, vi } from "vitest";
+import { getUpdates, sendMessage } from "../src/weixin/api.js";
+import { isDefinitelyUnsentNetworkError } from "../src/utils/network.js";
+const originalFetch = globalThis.fetch;
+afterEach(() => { globalThis.fetch = originalFetch; vi.useRealTimers(); });
+const params = { baseUrl: "https://invalid.test", token: "PRIVATE_TOKEN", body: { msg: { client_id: "same-id" } } };
+
+it("send timeout is uncertain rather than a synthetic success", async () => {
+  globalThis.fetch = vi.fn().mockRejectedValue(Object.assign(new Error("timeout"), { name: "AbortError" }));
+  await expect(sendMessage(params)).rejects.toMatchObject({ name: "AbortError" });
+  expect(globalThis.fetch).toHaveBeenCalledTimes(1);
+});
+
+it("long-poll timeout retains the empty-update sentinel", async () => {
+  globalThis.fetch = vi.fn().mockRejectedValue(Object.assign(new Error("timeout"), { name: "AbortError" }));
+  await expect(getUpdates({ ...params, get_updates_buf: "" })).resolves.toMatchObject({ ret: 0, msgs: [] });
+});
+
+it("sendmessage does not automatically retry socket-reset ambiguity", async () => {
+  globalThis.fetch = vi.fn().mockRejectedValue(Object.assign(new Error("reset"), { code: "ECONNRESET" }));
+  await expect(sendMessage(params)).rejects.toMatchObject({ code: "ECONNRESET" });
+  expect(globalThis.fetch).toHaveBeenCalledTimes(1);
+});
+
+it("sendmessage retries definite connection failures with one stable client id", async () => {
+  vi.useFakeTimers();
+  globalThis.fetch = vi.fn().mockRejectedValueOnce(Object.assign(new Error("connect"), { code: "ECONNREFUSED" }))
+    .mockResolvedValueOnce(new Response('{"ret":0}', { status: 200 }));
+  const sent = sendMessage(params); const asserted = expect(sent).resolves.toBeUndefined();
+  await vi.advanceTimersByTimeAsync(1000); await asserted;
+  const calls = (globalThis.fetch as any).mock.calls;
+  expect(calls).toHaveLength(2); expect(calls[0][1].body).toBe(calls[1][1].body);
+});
+
+it.each(["", "{}", "null", "[]", '{"note":"accepted?"}'])("rejects an unconfirmed send response %s", async body => {
+  globalThis.fetch = vi.fn().mockResolvedValue(new Response(body, { status: 200 }));
+  await expect(sendMessage({ ...params, retries: 0 })).rejects.toThrow(/confirm|accept|response/i);
+});
+
+it("a body-read failure after response headers cannot become a definitely-unsent retry", async () => {
+  globalThis.fetch = vi.fn().mockResolvedValue({ ok: true, text: async () => { throw Object.assign(new Error("body failed"), { code: "ECONNREFUSED" }); } });
+  let caught: unknown; try { await sendMessage(params); } catch (error) { caught = error; }
+  expect(caught).toBeInstanceOf(Error); expect(globalThis.fetch).toHaveBeenCalledTimes(1);
+  expect(isDefinitelyUnsentNetworkError(caught)).toBe(false);
+});
+
+it("the send timeout remains armed until the response body finishes", async () => {
+  vi.useFakeTimers();
+  globalThis.fetch = vi.fn().mockImplementation(async (_url, options) => ({ ok: true,
+    text: () => new Promise((_resolve, reject) => options.signal.addEventListener("abort", () => reject(Object.assign(new Error("body timeout"), { name: "AbortError" })))) }));
+  const outcome = sendMessage(params).then(() => "sent", () => "uncertain");
+  await vi.advanceTimersByTimeAsync(15000);
+  expect(await outcome).toBe("uncertain");
+});
diff --git a/tests/dot-delivery.test.ts b/tests/dot-delivery.test.ts
