@@ -0,0 +1,28 @@
+import { describe, expect, it, vi } from "vitest";
+import { AgentStore } from "../src/dsh/sessions.js";
+
+describe("synchronous bridge admission", () => {
+  it.each(["queue", "steer"] as const)("can consume the identified frozen message before %s enqueue", mode => {
+    const store = new AgentStore({ get: () => undefined, on: () => () => {} });
+    const agent = { followup: vi.fn(), steer: vi.fn() } as any;
+    let created: any;
+    const id = store.followup(agent, [{ type: "text", text: "synthetic recovery request" }], mode, ((_id: string, message: unknown) => {
+      created = message;
+      return false;
+    }) as any);
+    expect(created?.id).toBe(id);
+    expect(Object.isFrozen(created)).toBe(true);
+    expect(created.source).toEqual({ kind: "user" });
+    expect(agent.followup).not.toHaveBeenCalled(); expect(agent.steer).not.toHaveBeenCalled();
+  });
+
+  it("keeps normal callback and no-hook forwarding compatible", () => {
+    const store = new AgentStore({ get: () => undefined, on: () => () => {} });
+    const agent = { followup: vi.fn(), steer: vi.fn() } as any;
+    const callback = vi.fn();
+    store.followup(agent, [{ type: "text", text: "new request" }], "queue", callback);
+    store.followup(agent, [{ type: "text", text: "another request" }], "steer");
+    expect(agent.followup).toHaveBeenCalledOnce(); expect(agent.steer).toHaveBeenCalledOnce();
+    expect(callback.mock.calls[0][0]).toBe(agent.followup.mock.calls[0][0].id);
+  });
+});
